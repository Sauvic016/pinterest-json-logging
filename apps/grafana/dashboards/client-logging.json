    "description": "Feature health for simulated Pin saves. Metrics use stored events and server receive time.",
    "editable": true,
    "elements": {
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "demo-postgres"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT count(*)::bigint AS attempts, count(*) FILTER (WHERE event_name = 'pin_save_succeeded')::bigint AS succeeded, count(*) FILTER (WHERE event_name = 'pin_save_failed')::bigint AS failed, 100.0 * count(*) FILTER (WHERE event_name = 'pin_save_succeeded') / NULLIF(count(*), 0) AS success_percent FROM public.events WHERE app = 'pin-demo' AND event_name IN ('pin_save_succeeded', 'pin_save_failed') AND $__timeFilter(received_at)"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Recorded attempts = saved success events + saved failure events. Success percentage = successful saves / recorded attempts x 100. Other diagnostic events are excluded. No attempts means no percentage.",
          "id": 5,
          "links": [],
          "title": "Pin save health (selected time range)",
