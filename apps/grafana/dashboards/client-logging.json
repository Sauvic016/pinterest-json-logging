      "panel-9": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "demo-postgres"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH save_durations AS (SELECT received_at, app_version, CASE WHEN jsonb_typeof(attributes->'duration_ms') = 'number' THEN (attributes->>'duration_ms')::double precision END AS duration_ms FROM public.events WHERE app = 'pin-demo' AND event_name IN ('pin_save_succeeded', 'pin_save_failed') AND $__timeFilter(received_at)) SELECT $__timeGroupAlias(received_at, '1m', NULL), app_version, percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) AS p50, percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) AS p95 FROM save_durations WHERE duration_ms >= 0 GROUP BY 1, 2 ORDER BY 1, 2"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Generated demo durations in milliseconds, not measured network latency. p50 is the median; p95 is the 95th percentile. Only numeric, nonnegative duration_ms values from save outcomes are included.",
          "id": 9,
          "links": [],
          "title": "Simulated save duration (p50 / p95), by version",
