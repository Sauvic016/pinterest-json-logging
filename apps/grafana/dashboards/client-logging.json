                        "rawQuery": true,
                        "rawSql": "SELECT $__timeGroupAlias(received_at, '1m', NULL), app_version AS metric, 100.0 * count(*) FILTER (WHERE event_name = 'pin_save_succeeded') / NULLIF(count(*), 0) AS success_percent FROM public.events WHERE app = 'pin-demo' AND event_name IN ('pin_save_succeeded', 'pin_save_failed') AND $__timeFilter(received_at) GROUP BY 1, 2 ORDER BY 1, 2"
